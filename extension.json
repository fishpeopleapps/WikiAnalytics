{
	"name": "WikiAnalytics",
	"version": "1.0",
	"author": [
		"Kimberly Brewer [ITSC]"
	],
	"descriptionmsg": "wikianalytics-desc",
	"license-name": "GPL-2.0-or-later",
	"type": "other",
	"requires": {
		"MediaWiki": ">= 1.43.0",
        "extensions": {
            "TimedMediaHandler": ">=0.6.0"
        }
	},
	"MessagesDirs": {
		"WikiAnalytics": "i18n"
	},
	"ExtensionMessagesFiles": {
		"WikiAnalyticsAlias": "i18n/en.alias.php"
	},
	"APIModules": {
		"wikianalytics": {
			"class": "MediaWiki\\Extension\\WikiAnalytics\\ApiWikiAnalytics"
		}
	},
	"AutoloadNamespaces": {
    	"MediaWiki\\Extension\\WikiAnalytics\\": "includes/"
	},
    "ResourceModules": {
		"ext.wikiAnalytics": {
			"styles": [
				"extensions/WikiAnalytics/resources/flatpickr.min.css",
				"extensions/WikiAnalytics/resources/ext.wikiAnalytics.css"
				
			],
			"scripts": [
				"extensions/WikiAnalytics/resources/flatpickr.min.js",
				"extensions/WikiAnalytics/resources/chart.min.js",
				"extensions/WikiAnalytics/resources/ext.wikiAnalytics.js"
				
			]
		}
	},
	"Hooks": {
  		"LoadExtensionSchemaUpdates": "MediaWiki\\Extension\\WikiAnalytics\\Hooks::onLoadExtensionSchemaUpdates"
	},
	"schemaUpdates": {
  		"sqlite": [
			"sql/audio_play_events.sql",
			"sql/monthly_audio_analytics.sql",
			"sql/monthly_filetype_breakdown.sql",
			"sql/monthly_namespace_breakdown.sql",
			"sql/monthly_top_audio.sql",
			"sql/monthly_top_pages.sql",
			"sql/monthly_top_users.sql",
    		"sql/persisted_monthly_analytics.sql"
  		]
	},
	"SpecialPages": {
		"WikiAnalytics": {
			"class": "MediaWiki\\Extension\\WikiAnalytics\\SpecialWikiAnalytics"
		}
	},
	"MaintenanceScripts": {
   		"WikiAnalytics:CaptureMonthlyWikiStats": "maintenance/CaptureMonthlyWikiStats.php",
    	"WikiAnalytics:TestWikiAnalyticsRead": "maintenance/TestWikiAnalyticsRead.php"
	},

	"manifest_version": 2
}